<?xml version="1.0" encoding="utf-8"?>
<!-- The window background the OS paints from process start until Flutter's
     first frame.

     A flat fill of the splash artwork's own background colour, and nothing
     else. It used to draw `splash_bg` here too, with android:gravity="fill" —
     which stretches, while the Dart SplashScreen draws the same image with
     BoxFit.cover, which crops. On any screen whose aspect ratio differs from
     the artwork's, the handoff therefore rescaled the picture: the "splash,
     then a slightly zoomed splash" blink. Leaving the artwork to Flutter alone
     means it is drawn once, at one scale, and the only thing the native window
     contributes is the colour behind it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_color" />
</layer-list>

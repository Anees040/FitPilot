<?xml version="1.0" encoding="utf-8"?>
<!-- A deliberately empty icon for the Android 12+ system splash screen.

     Android 12 and up always draw a system splash before the app's first frame,
     and if `windowSplashScreenAnimatedIcon` is unset the platform falls back to
     the launcher icon. Either way the user saw a small centred mark on orange,
     and then Flutter's first frame replaced it with the full-bleed
     `splash_bg.webp` — two different pictures in sequence, which is the
     "splash, then a slightly zoomed splash" blink.

     Pointing the system splash at a transparent shape leaves it as a flat fill
     of @color/splash_color, matching the artwork's own background. The artwork
     then appears on an already-orange screen, so there is exactly one splash
     image in the whole startup and nothing to blink between. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
